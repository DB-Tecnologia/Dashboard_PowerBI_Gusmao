# Copie este arquivo no host para .env.preview e troque todos os valores de exemplo.
# Gere segredos longos, aleatórios e somente alfanuméricos para evitar problemas no Compose/SQL.
PREVIEW_DOMAIN=srv1728931.hstgr.cloud

AUTH_DEMO_USER_EMAIL=cliente.demo@example.com
AUTH_DEMO_USER_PASSWORD=troque-por-uma-senha-aleatoria-exclusiva
AUTH_DEMO_VIEWER_ONLY=true
JWT_ACCESS_SECRET=troque-por-64-ou-mais-caracteres-aleatorios
TOTP_ENCRYPTION_KEY=troque-por-64-ou-mais-caracteres-aleatorios
TOTP_ENCRYPTION_SALT=troque-por-64-ou-mais-caracteres-aleatorios

MSSQL_SA_PASSWORD=troque-por-senha-aleatoria-forte
SQLSERVER_APP_PASSWORD=troque-por-senha-aleatoria-forte
SQLSERVER_DATABASE=DashboardPowerBI

NODE_ENV=production
APP_MODE=demo
DATA_MODE=mock
DATABASE_PROVIDER=sqlserver
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_USE_MOCK_DATA=true
CORS_ORIGINS=https://srv1728931.hstgr.cloud
TRUST_PROXY_HOPS=1
REDIS_HOST=redis
REDIS_PORT=6379
SQLSERVER_HOST=sqlserver
SQLSERVER_PORT=1433
SQLSERVER_USER=dashboard_reader
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
EXPORT_STORAGE_DIR=/workspace/storage/exports
EXPORT_PUBLIC_BASE_URL=https://srv1728931.hstgr.cloud/api/exports/files
SMTP_MODE=mock
